    "home_advantages": {
      "type": "custom-html",
      "settings": {
        "code": "<section class=\"mr-adv\">\n  <div class=\"t4s-container\">\n    <div class=\"mr-adv__head\">\n      <p class=\"mr-adv__eyebrow\">Smart Ideas with Style</p>\n      <h2 class=\"mr-adv__title\">Cooling that goes where you go</h2>\n    </div>\n    <div class=\"mr-adv__grid\">\n      <div class=\"mr-adv__item\">\n        <div class=\"mr-adv__icon\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"14\" rx=\"1\"/><path d=\"M3 9h18M9 4v14\"/><path d=\"M4 21 20 3\"/></svg></div>\n        <h3>No hose, no window</h3>\n        <p>Ductless design cools your space without window kits or permanent installation.</p>\n      </div>\n      <div class=\"mr-adv__item\">\n        <div class=\"mr-adv__icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2v20M4.2 6.5l15.6 11M19.8 6.5L4.2 17.5\"/><path d=\"M12 5.5 9.8 3.3M12 5.5l2.2-2.2M12 18.5l-2.2 2.2M12 18.5l2.2 2.2\"/></svg></div>\n        <h3>3-in-1 comfort</h3>\n        <p>Cool, circulate and dehumidify with one compact unit built for everyday rooms.</p>\n      </div>\n      <div class=\"mr-adv__item\">\n        <div class=\"mr-adv__icon\"><svg viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"3.5\" width=\"12\" height=\"13.5\" rx=\"1.5\"/><circle cx=\"9\" cy=\"20\" r=\"1.6\"/><circle cx=\"15\" cy=\"20\" r=\"1.6\"/><path d=\"M9 8h6\"/></svg></div>\n        <h3>Move it anywhere</h3>\n        <p>Lightweight and easy to roll between bedrooms, living rooms and home offices.</p>\n      </div>\n      <div class=\"mr-adv__item\">\n        <div class=\"mr-adv__icon\"><svg viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"2.5\" width=\"14\" height=\"19\" rx=\"2\"/><path d=\"M9 11h6M9 15h4\"/></svg></div>\n        <h3>Smart touch control</h3>\n        <p>Clear touchscreen controls make setup, modes and scheduling simple.</p>\n      </div>\n    </div>\n  </div>\n</section>",
        "layout": "t4s-container-fluid",
        "mg": ",,-20px,",
        "mg_mb": ",,-10px,"
      }
    },
