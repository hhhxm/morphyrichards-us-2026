<div class="mr-dform">
  <div class="mr-dform__header">
    <h3 class="mr-dform__title">Join Our Licensee Network</h3>
    <p class="mr-dform__desc">It s time to take your business to the next level by incorporating Morphy Richards into your portfolio.</p>
  </div>
  <ul class="mr-dform__ticks">
    <li>Exclusive distribution within a definite region</li>
    <li>Reliable supply chain and strong after-sales network</li>
    <li>Abundant R&amp;D resources, staying ahead of the curve</li>
  </ul>
  <form class="mr-dform__form" novalidate>
    <div class="mr-dform__row">
      <input class="mr-dform__input" type="text" name="name" placeholder="Name*" required>
      <input class="mr-dform__input" type="text" name="company" placeholder="Company Name*" required>
    </div>
    <input class="mr-dform__input" type="email" name="email" placeholder="Email Address*" required>
    <input class="mr-dform__input" type="text" name="country" placeholder="Which country do you want to have business in?*" required>
    <label class="mr-dform__terms">
      <input type="checkbox" name="terms" required>
      <span>I accept the <a href="/policies/terms-of-service" target="_blank" rel="noopener">Terms of Use</a> and <a href="/policies/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a>.*</span>
    </label>
    <p class="mr-dform__privacy">Your privacy is our priority. Your information will not be shared and is held securely. We adhere to all specific requirements mandated by (GDPR) and the ePrivacy Directive for data protection and privacy.</p>
    <div class="mr-dform__actions"><button type="submit">Submit</button></div>
  </form>
</div>
<script>
(function(){
  var f=document.querySelector('.mr-dist-page .mr-dform__form');
  if(!f) return;
  var get=function(n){var el=f.querySelector('[name="'+n+'"]');return el?String(el.value).trim():'';};
  f.addEventListener('submit',function(e){
    e.preventDefault();
    if(!get('name')||!get('company')||!get('email')||!get('country')||!f.querySelector('[name="terms"]').checked){
      if(f.reportValidity) f.reportValidity();
      return;
    }
    var body='Name: '+get('name')+'\nCompany: '+get('company')+'\nEmail: '+get('email')+'\nCountry: '+get('country');
    window.location.href='mailto:marketing@morphyrichards.com?subject='+encodeURIComponent('Distribution Enquiry - '+get('company'))+'&body='+encodeURIComponent(body);
  });
})();
