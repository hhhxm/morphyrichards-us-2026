{%- comment -%}
  Contact form (mailto) — one single enquiry form for /pages/contact.
  Submitting opens the visitor's local mail app (mailto:) with the fields pre-filled,
  so no Shopify customer/contact data is stored. Styles live in assets/mr-sections.css.
{%- endcomment -%}
{%- liquid
  assign se_stts = section.settings
  assign anchor = se_stts.anchor_id | default: 'support'
  assign mail = se_stts.email | default: 'marketing@morphyrichards.com'
-%}
<div class="mr-cform" id="{{ anchor }}">
  <span class="mr-cform__anchor" id="distributor" aria-hidden="true"></span>
  <div class="mr-cform__card">
    {%- if se_stts.title != blank -%}
      <h2 class="mr-cform__title">{{ se_stts.title }}</h2>
    {%- endif -%}
    {%- if se_stts.intro != blank -%}
      <p class="mr-cform__desc">{{ se_stts.intro | escape | newline_to_br }}</p>
    {%- endif -%}
    {%- if se_stts.items != blank -%}
      <ul class="mr-cform__ticks">
        {%- assign lines = se_stts.items | newline_to_br | split: '<br />' -%}
        {%- for line in lines -%}
          {%- assign item = line | strip -%}
          {%- if item != blank -%}<li>{{ item | escape }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <form class="mr-cform__form" action="mailto:{{ mail }}" method="post" enctype="text/plain">
      <div class="mr-cform__row">
        <input class="mr-cform__input" type="text" name="name" placeholder="Name*" aria-label="Name" required>
        <input class="mr-cform__input" type="text" name="company" placeholder="Company Name" aria-label="Company name">
      </div>
      <input class="mr-cform__input" type="email" name="email" placeholder="Email Address*" aria-label="Email address" required>
      <input class="mr-cform__input" type="text" name="country" placeholder="Which country are you based in?*" aria-label="Country" required>
      <label class="mr-cform__terms">
        <input type="checkbox" name="terms" required>
        <span>I accept the <a href="/policies/terms-of-service" target="_blank" rel="noopener">Terms of Use</a> and <a href="/policies/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a>.*</span>
      </label>
      {%- if se_stts.privacy != blank -%}
        <p class="mr-cform__privacy">{{ se_stts.privacy | escape }}</p>
      {%- endif -%}
      <div class="mr-cform__actions">
        <button type="submit">{{ se_stts.button_label | default: 'Submit' }}</button>
      </div>
    </form>
    {%- if se_stts.show_stats -%}
      <ul class="mr-cform__stats">
        <li style="background-image:url({{ 'global.png' | file_url }})"><b>40+</b> Global Markets</li>
        <li style="background-image:url({{ 'leibiefenlei-2.png' | file_url }})"><b>9</b> Categories</li>
        <li style="background-image:url({{ 'zhuanyezhishi.png' | file_url }})"><b>90+</b> Years of Craftsmanship</li>
      </ul>
    {%- endif -%}
  </div>
</div>
<script>
  (function () {
    var root = document.querySelector('.mr-cform');
    if (!root) return;
    var form = root.querySelector('.mr-cform__form');
    if (!form) return;
    var val = function (name) {
      var el = form.querySelector('[name="' + name + '"]');
      return el ? String(el.value).trim() : '';
    };
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      if (!form.checkValidity()) {
        if (form.reportValidity) form.reportValidity();
        return;
      }
      var lines = [
        'Name: ' + val('name'),
        'Company: ' + val('company'),
        'Email: ' + val('email'),
        'Country: ' + val('country')
      ];
      window.location.href =
        'mailto:{{ mail | escape }}' +
        '?subject=' + encodeURIComponent('Website enquiry - ' + (val('company') || val('name'))) +
        '&body=' + encodeURIComponent(lines.join('\n'));
    });
  })();
</script>

{%- schema -%}
{
  "name": "Contact form (mailto)",
  "tag": "section",
  "class": "t4s-section t4s-section-all mr-contact-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "support",
      "info": "Navigation links to /pages/contact#support and #distributor land here"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Send Us a Message"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Questions about Morphy Richards products, partnerships or distribution? Fill in the form below and the right team will get back to you."
    },
    {
      "type": "textarea",
      "id": "items",
      "label": "Bullet list (one per line)",
      "default": "Customer support and after-sales questions\nMedia, press and review enquiries\nInfluencer and creator collaborations\nLicensee and distribution partnerships"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Send enquiries to",
      "default": "marketing@morphyrichards.com"
    },
    {
      "type": "textarea",
      "id": "privacy",
      "label": "Privacy note",
      "default": "Your privacy is our priority. Your information will not be shared and is held securely. We adhere to all specific requirements mandated by (GDPR) and the ePrivacy Directive for data protection and privacy."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Submit"
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "Show stats bar",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Contact form (mailto)"
    }
  ]
}
{%- endschema -%}
